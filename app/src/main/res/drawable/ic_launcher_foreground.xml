            android:fillColor="#0f172a"
            android:pathData="M18,27 A7,7 0 1,1 17.99,27 Z" />

        <!-- Right stick -->
        <path
            android:fillColor="#0f172a"
            android:pathData="M58,36 A6,6 0 1,1 57.99,36 Z" />

        <!-- D-pad cross -->
        <path
            android:fillColor="#0f172a"
            android:pathData="M8,30 L8,38 L12,38 L12,42 L20,42 L20,38 L24,38 L24,30 L20,30 L20,26 L12,26 L12,30 Z" />

        <!-- ABXY buttons (small circles) -->
        <path
            android:fillColor="#0f172a"
            android:pathData="M68,25 A3,3 0 1,1 67.99,25 Z" />
        <path
            android:fillColor="#0f172a"
            android:pathData="M74,31 A3,3 0 1,1 73.99,31 Z" />
        <path
            android:fillColor="#0f172a"
            android:pathData="M62,31 A3,3 0 1,1 61.99,31 Z" />
        <path
            android:fillColor="#0f172a"
            android:pathData="M68,37 A3,3 0 1,1 67.99,37 Z" />

    </group>
</vector>
