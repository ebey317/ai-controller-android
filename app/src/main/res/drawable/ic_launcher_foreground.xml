<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: gamepad/AI glyph. Uses only vector path elements. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#38bdf8"
    android:tintMode="multiply">
    <group
        android:translateX="14"
        android:translateY="20"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- Controller body -->
        <path
            android:fillColor="#38bdf8"
            android:pathData="M20,8 L60,8 C74,8 86,20 86,34 C86,52 74,64 60,64 L20,64 C6,64 -6,52 -6,34 C-6,20 6,8 20,8 Z" />

        <!-- Left stick (circle rendered as path) -->
