    <!--
        Placeholder build-time fallback only — do NOT put a real Groq API key
        here. Any key placed in this resource (or in the gitignored
        groq_api_key.xml override) is compiled directly into the APK and ships
        inside any distributed build, where it can be extracted by anyone with
        the APK. This resource must stay a compile-time contract (R.string.
        groq_api_key) so the app builds; transcribeWithGroq's guard refuses this
        exact placeholder value. The safe path is entering the key at runtime in
        the app's Groq API key field (MainActivity), which GroqKeyStore persists
        to this app's own private on-device storage and which
        transcribeWithGroq checks before ever reading this resource.
    -->
    <string name="groq_api_key" translatable="false">YOUR_GROQ_API_KEY</string>
